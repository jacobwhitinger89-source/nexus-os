# NEXUS OS BusyBox additions on top of Buildroot's default configuration.
CONFIG_FEATURE_DEFAULT_PASSWD_ALGO="sha512"
CONFIG_USE_BB_CRYPT=y
CONFIG_USE_BB_CRYPT_SHA=y
CONFIG_CHPASSWD=y
CONFIG_CRYPTPW=y
CONFIG_MKPASSWD=y
CONFIG_ADDUSER=y
CONFIG_ADDGROUP=y
CONFIG_DELUSER=y
CONFIG_DELGROUP=y
CONFIG_FEATURE_ADDUSER_TO_GROUP=y
CONFIG_UDHCPC=y
CONFIG_UDHCPC6=y
CONFIG_NTPD=y
CONFIG_WATCHDOG=y
CONFIG_ACPID=y
CONFIG_FEATURE_ACPID_COMPAT=y
CONFIG_SYSLOGD=y
CONFIG_FEATURE_ROTATE_LOGFILE=y
CONFIG_FEATURE_SYSLOGD_READ_BUFFER_SIZE=256
CONFIG_KLOGD=y
CONFIG_LOGGER=y
CONFIG_MDEV=y
CONFIG_FEATURE_MDEV_CONF=y
CONFIG_FEATURE_MDEV_EXEC=y
CONFIG_FEATURE_MDEV_LOAD_FIRMWARE=y
CONFIG_TIMEOUT=y
CONFIG_FLOCK=y
CONFIG_SETSID=y
CONFIG_START_STOP_DAEMON=y
CONFIG_TAR=y
CONFIG_FEATURE_TAR_GNU_EXTENSIONS=y
CONFIG_FEATURE_TAR_LONG_OPTIONS=y
CONFIG_FEATURE_SEAMLESS_GZ=y
CONFIG_FEATURE_SEAMLESS_XZ=y
CONFIG_FEATURE_SEAMLESS_ZSTD=y
CONFIG_SHA256SUM=y
CONFIG_FSYNC=y
CONFIG_SYNC=y
CONFIG_NPROC=y
CONFIG_TELNETD=n
CONFIG_FTPD=n
CONFIG_TFTPD=n
CONFIG_HTTPD=n
CONFIG_INETD=n
CONFIG_BLOCKDEV=y

# NEXUS OS — x86-64 reference configuration (Buildroot 2026.02 LTS)
BR2_x86_64=y

# Toolchain: pinned Bootlin musl toolchain (checksummed by Buildroot)
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_X86_64_MUSL_STABLE=y

# Build hygiene
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_NEXUS_PATH)/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_REPRODUCIBLE=y
BR2_STRIP_strip=y
BR2_OPTIMIZE_S=y
BR2_SSP_STRONG=y
BR2_RELRO_FULL=y
BR2_FORTIFY_SOURCE_2=y

# System
BR2_TARGET_GENERIC_HOSTNAME="nexus"
BR2_TARGET_GENERIC_ISSUE="NEXUS OS"
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
BR2_TARGET_ENABLE_ROOT_LOGIN=n
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_TARGET_GENERIC_GETTY=n
BR2_SYSTEM_DHCP=""
BR2_TARGET_TZ_INFO=n
BR2_ROOTFS_MERGED_USR=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_NEXUS_PATH)/../system/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_NEXUS_PATH)/board/nexus/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_NEXUS_PATH)/board/nexus/post-image.sh"
BR2_ROOTFS_POST_FAKEROOT_SCRIPT="$(BR2_EXTERNAL_NEXUS_PATH)/board/nexus/post-fakeroot.sh"

# Kernel: Linux 6.18 longterm
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.60"
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_NEXUS_PATH)/board/nexus/linux.fragment"
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
BR2_LINUX_KERNEL_BZIMAGE=y

# BusyBox
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_NEXUS_PATH)/board/nexus/busybox.fragment"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=n

# Remote access
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y
BR2_PACKAGE_DROPBEAR_WTMP=n
BR2_PACKAGE_DROPBEAR_LASTLOG=n
BR2_PACKAGE_MDNSD=y
BR2_PACKAGE_MDNSD_MQUERY=y
BR2_PACKAGE_MDNSD_SSH_SERVICE=y
BR2_PACKAGE_NFTABLES=y
BR2_PACKAGE_SUDO=y
BR2_PACKAGE_CA_CERTIFICATES=y

# Storage and installation
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_LIBBLKID=y
BR2_PACKAGE_UTIL_LINUX_LIBFDISK=y
BR2_PACKAGE_UTIL_LINUX_LIBSMARTCOLS=y
BR2_PACKAGE_UTIL_LINUX_LIBUUID=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_WIPEFS=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_FSCK=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_SMARTMONTOOLS=y

# NEXUS management components
BR2_PACKAGE_NEXUS_TOOLS=y

# Bootloader: GRUB 2 for BIOS and UEFI. The target tools are installed so
# the installer can run grub-install and A/B updates can use grub-editenv.
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_I386_PC=y
BR2_TARGET_GRUB2_X86_64_EFI=y
BR2_TARGET_GRUB2_INSTALL_TOOLS=y

# Images: zstd initramfs (live/installer) + squashfs (installed slots)
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_ZSTD=y
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y
BR2_TARGET_ROOTFS_TAR=n

# Host tools used by post-image.sh to assemble the hybrid ISO
BR2_PACKAGE_HOST_XORRISO=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
# Firmware for Realtek Ethernet (r8169 loads it when the link is opened)
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_8169=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_815X=y

#!/usr/sbin/nft -f
# NEXUS OS default firewall. Inbound is denied unless listed here or opened
# by nexusd for a project port declared public (sets public_tcp/public_udp).
flush ruleset

table inet nexus {
	set public_tcp { type inet_service; }
	set public_udp { type inet_service; }

	# Per-source SSH connection rate limiting (brute-force protection).
	set ssh_v4 { type ipv4_addr; flags dynamic, timeout; timeout 5m; size 8192; }
	set ssh_v6 { type ipv6_addr; flags dynamic, timeout; timeout 5m; size 8192; }

	chain input {
		type filter hook input priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
		iif lo accept
		meta l4proto icmp limit rate 20/second accept
		meta l4proto ipv6-icmp accept
		udp dport 5353 accept comment "mDNS"
		udp sport 67 udp dport 68 accept comment "DHCPv4"
		udp sport 547 udp dport 546 accept comment "DHCPv6"
		tcp dport 22 ct state new add @ssh_v4 { ip saddr limit rate over 12/minute burst 6 packets } log prefix "nexus-fw ssh-ratelimit " level warn drop
		tcp dport 22 ct state new add @ssh_v6 { ip6 saddr limit rate over 12/minute burst 6 packets } log prefix "nexus-fw ssh-ratelimit " level warn drop
		tcp dport 22 accept
		tcp dport @public_tcp accept
		udp dport @public_udp accept
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
	}
}

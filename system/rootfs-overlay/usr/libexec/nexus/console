#!/bin/sh
# Local console session for tty1 / ttyS0.
#  live mode:      the NEXUS installer (falls back to a root shell)
#  installed mode: a normal login prompt (local recovery access)
. /usr/libexec/nexus/lib.sh
tty=$1
dev=/dev/$tty
[ -c "$dev" ] && stty -F "$dev" >/dev/null 2>&1 || exec sleep 2147483647

if [ "$(nx_mode)" = installed ]; then
	case $tty in
	ttyS*) exec getty -L 115200 "$tty" vt100 ;;
	*) exec getty 38400 "$tty" linux ;;
	esac
fi

# BusyBox init already made us a session leader with $dev as stdio and
# controlling terminal; just exec (setsid here would fork, and init would
# respawn a second session on the same terminal).
if [ -x /usr/sbin/nexus-install ] && ! nx_cmdline nexus.shell >/dev/null; then
	exec /usr/sbin/nexus-install --console
fi
exec /bin/sh -l

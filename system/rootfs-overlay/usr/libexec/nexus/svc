#!/bin/sh
# Run one supervised system daemon in the foreground (called from inittab).
# If the daemon does not apply to the current boot mode, park forever so
# BusyBox init does not respawn-loop it.
. /usr/libexec/nexus/lib.sh
name=$1
mode=$(nx_mode)

park() { exec sleep 2147483647; }

# Daemons never use the console: they log to syslog (nexusd's stderr is
# piped into syslog below).
exec </dev/null >/dev/null 2>&1

# Respawn throttle: a daemon that exits within 10 s of its previous start
# (e.g. ntpd before DNS works) waits 10 s instead of looping in init.
stamp=/run/nexus/svc-$name.started
now=$(cut -d. -f1 /proc/uptime)
# Intentional restarts (nexus ssh finalize, hostname change, ...) leave
# /run/nexus/svc-<name>.restart and are not delayed.
if [ -f "/run/nexus/svc-$name.restart" ]; then
	rm -f "/run/nexus/svc-$name.restart"
elif [ -f "$stamp" ] && [ $((now - $(cat "$stamp"))) -lt 10 ]; then
	sleep 10
	now=$(cut -d. -f1 /proc/uptime)
fi
echo "$now" > "$stamp"
installed_only() { [ "$mode" = installed ] || park; }

case "$name" in
mdev)
	# Hotplug daemon on the kernel uevent netlink socket.
	exec mdev -df ;;
syslogd)
	# 4 rotated files x 2 MiB keeps logs bounded on small disks.
	exec syslogd -n -O /var/log/messages -s 2048 -b 4 ;;
klogd)
	exec klogd -n ;;
network)
	exec /usr/libexec/nexus/netd ;;
ntpd)
	NTP_SERVERS="pool.ntp.org"
	[ -f /data/etc/nexus/ntp.conf ] && . /data/etc/nexus/ntp.conf
	[ "$NTP_SERVERS" = none ] && park
	set --
	for s in $NTP_SERVERS; do set -- "$@" -p "$s"; done
	exec ntpd -n "$@" ;;
acpid)
	# Power button => clean shutdown.
	exec acpid -f -c /etc/acpi ;;
watchdog)
	[ -c /dev/watchdog ] || park
	WATCHDOG=yes
	[ -f /data/etc/nexus/watchdog.conf ] && . /data/etc/nexus/watchdog.conf
	[ "$WATCHDOG" = yes ] || park
	# Kick every 10 s; the hardware resets the machine after 60 s of silence.
	exec watchdog -F -t 10 -T 60 /dev/watchdog ;;
dropbear)
	installed_only
	exec /usr/libexec/nexus/sshd ;;
mdnsd)
	installed_only
	until nx_net_ready; do sleep 1; done
	nx_ipv4 "$(cat /run/nexus/net-interface)" > /run/nexus/mdnsd.addr
	exec mdnsd -n -s /etc/mdns.d ;;
nexusd)
	[ -x /usr/sbin/nexusd ] || park
	# Not exec: the shell waits for the pipeline, so init still sees the
	# service exit when nexusd dies and respawns it.
	/usr/sbin/nexusd 2>&1 | logger -t nexusd
	exit 1 ;;
*)
	echo "svc: unknown service $name" >&2
	park ;;
esac
